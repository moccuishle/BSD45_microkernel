.encoding = "windows-1252"
config.version = "8"
virtualHW.version = "12"
displayName = "BSD45-ELF-x86"
guestOS = "other"
memsize = "512"
numvcpus = "1"

# El Torito CD (the ISO contains an ELF32 kernel, not a PE image)
ide1:0.present = "TRUE"
ide1:0.deviceType = "cdrom-image"
ide1:0.fileName = "..\out\BSD45-ELF-x86.iso"
ide1:0.startConnected = "TRUE"

usb.present = "FALSE"

# The guest kernel has no USB stack: it polls the legacy 8042 keyboard
# controller.  VMware 17 defaults to a virtual USB keyboard, which the
# guest would never see, so force the PS/2 (i8042) keyboard/mouse.
keyboard.vusb.enable = "FALSE"
mouse.vusb.enable = "FALSE"
keyboard.allowBothIRQs = "FALSE"

bios.bootOrder = "cdrom"
bios.hddOrder = ""

# No serial0 device on purpose: a file-backed port captures nothing from this
# guest and a network-backed one blocks the vCPU when nobody is connected.
# Serial file for automated proctest capture (VM_FORCE_COM1 build).
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "bsd45-proctest-serial.log"

extendedConfigFile = "BSD45-proctest.vmxf"
virtualHW.productCompatibility = "hosted"
ide0:0.present = "FALSE"
floppy0.present = "FALSE"
ethernet0.present = "FALSE"
sound.present = "FALSE"
vmxstats.filename = "BSD45-ELF-x86.scoreboard"
numa.autosize.cookie = "10001"
numa.autosize.vcpu.maxPerVirtualNode = "1"
uuid.bios = "56 4d 37 17 d1 42 19 b7-29 70 6e ad 39 68 61 a1"
uuid.location = "56 4d 37 17 d1 42 19 b7-29 70 6e ad 39 68 61 a1"
svga.vramSize = "134217728"
vmotion.checkpointFBSize = "134217728"
vmotion.checkpointSVGAPrimarySize = "134217728"
monitor.phys_bits_used = "42"
cleanShutdown = "FALSE"
softPowerOff = "FALSE"

# gdb remote stub for kernel debugging (see os_vmware_debug.md)
